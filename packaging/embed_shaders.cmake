# === Portable release (v3.6.0) ===
# Generates EmbeddedShaders.cpp: every shaders/*.vert|*.frag is baked into the
# binary, so a standalone astro-voyager.exe runs without a shaders/ folder.
# Invoked by CMakeLists.txt at configure time (GL target only):
#   cmake -DSHADER_DIR=<repo>/shaders -DOUT=<build>/generated/EmbeddedShaders.cpp
#         -P packaging/embed_shaders.cmake
# Table names match the runtime call sites ("shaders/x.frag"). Sorted order
# keeps the generated file deterministic.
if(NOT DEFINED SHADER_DIR OR NOT DEFINED OUT)
  message(FATAL_ERROR "embed_shaders.cmake: SHADER_DIR and OUT are required")
endif()

file(GLOB shader_files
  "${SHADER_DIR}/*.vert"
  "${SHADER_DIR}/*.frag")
list(SORT shader_files)
list(LENGTH shader_files shader_count)
if(shader_count EQUAL 0)
  message(FATAL_ERROR "embed_shaders.cmake: no shaders found in ${SHADER_DIR}")
endif()

file(WRITE "${OUT}"
"// Generated by packaging/embed_shaders.cmake at configure time. Do not edit.\n"
"#include \"EmbeddedShaders.h\"\n"
"\n"
"namespace astro {\n"
"namespace {\n"
"const struct { const char* name; const char* data; } kEmbeddedShaders[] = {\n")

foreach(path IN LISTS shader_files)
  get_filename_component(name "${path}" NAME)
  file(READ "${path}" content)
  # Delimiter )GLSL" does not occur in any shader (checked by static test).
  file(APPEND "${OUT}" "{\"shaders/${name}\", R\"GLSL(${content})GLSL\"},\n")
endforeach()

file(APPEND "${OUT}"
"};\n"
"}  // namespace\n"
"\n"
"const char* embeddedShader(const std::string& name) {\n"
"  for (const auto& s : kEmbeddedShaders) {\n"
"    if (name == s.name) return s.data;\n"
"  }\n"
"  return nullptr;\n"
"}\n"
"\n"
"}  // namespace astro\n")

message(STATUS "EmbeddedShaders: ${shader_count} shaders -> ${OUT}")
