#version 330 core
// Варп-кокон: выход в линейный HDR (композит накладывает единственную
// гамму). Тонкие деликатные струи ауры и эфирная хризалида мягко ложатся
// аддитивным блендингом поверх корпуса корабля и звёздного фона.
// v4.1: повышенная прозрачность линий и мягкий френель.
in vec3 v_Color;
out vec4 FragColor;
void main() {
  FragColor = vec4(pow(max(v_Color, vec3(0.0)), vec3(2.2)), 1.0);
}
