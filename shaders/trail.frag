#version 330 core
// Варп-кокон: выход в линейный HDR (композит накладывает единственную
// гамму). Яркость > 0.72 попадает в блум — тонкие струи получают glow.
// v4.0: режим 3 (хризалида) — v_Color уже содержит френель/пятна, здесь
// просто гамма-переход, как у остальных режимов.
in vec3 v_Color;
out vec4 FragColor;
void main() {
  FragColor = vec4(pow(max(v_Color, vec3(0.0)), vec3(2.2)), 1.0);
}
